            {
              "value": 0.29,
              "label": "Normal"
            },
            {
              "value": 0.38,
              "label": "Wide"
            }
          ]
        }
      ],
      "program": {
        "version": 1,
        "state": {
          "phase": 0,
          "left": 0.3,
