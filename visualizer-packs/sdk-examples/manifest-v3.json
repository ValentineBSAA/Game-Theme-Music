            ]
          },
          {
            "do": "if",
            "test": [
              "get",
              "human2"
            ],
            "then": [
              {
                "do": "set",
                "var": "right",
                "value": [
                  "clamp",
                  [
                    "add",
                    [
                      "get",
                      "right"
                    ],
                    [
                      "mul",
                      [
                        "get",
                        "p2y"
                      ],
                      [
                        "mul",
                        [
                          "get",
                          "dt"
                        ],
                        0.7
                      ]
                    ]
                  ],
                  0.14,
                  0.86
                ]
              }
            ],
            "else": [
              {
                "do": "set",
                "var": "right",
                "value": [
                  "add",
                  0.5,
                  [
                    "mul",
                    [
                      "get",
                      "opt_spread"
                    ],
                    [
                      "cos",
                      [
                        "get",
                        "phase"
                      ]
                    ]
                  ]
                ]
              }
            ]
          },
          {
            "do": "set",
            "var": "burst",
            "value": [
              "max",
              0,
              [
                "sub",
                [
                  "get",
                  "burst"
                ],
                [
                  "mul",
                  [
                    "get",
                    "dt"
                  ],
                  1.1
                ]
              ]
            ]
          },
          {
            "do": "if",
            "test": [
              "or",
              [
                "get",
                "p1rb"
              ],
              [
                "get",
                "p2rb"
              ]
            ],
            "then": [
              {
                "do": "set",
                "var": "burst",
                "value": 1
              }
            ]
          },
          {
            "do": "if",
            "test": [
              "or",
              [
                "get",
                "p1a"
              ],
              [
                "get",
                "p2a"
              ]
            ],
            "then": [
              {
                "do": "set",
                "var": "burst",
                "value": 1
              }
            ]
          }
        ],
        "draw": [
          {
            "do": "line",
            "x": 0.23,
            "y": [
              "get",
              "left"
            ],
            "x2": 0.77,
