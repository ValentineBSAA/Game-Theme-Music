                "value": [
                  "clamp",
                  [
                    "add",
                    [
                      "get",
                      "left"
                    ],
                    [
                      "mul",
                      [
                        "get",
                        "p1y"
                      ],
                      [
                        "mul",
                        [
                          "get",
                          "dt"
