{
  "format": 3,
  "pack_id": "universal_lab_418",
  "name": "GTM Universal Visualizer Lab",
  "author": "Valentine / GTM SDK",
  "version": "1.0.0",
  "description": "Three format-3 demonstrations: a configurable ambient world, a solo music arcade game with AI autopilot, and local two-player interactive artwork. No executable code.",
  "scenes": [
    {
      "id": "world_lab_pulse_atlas",
      "title": "Pulse Atlas \u00b7 Procedural",
      "category": "signature",
      "background": {
        "style": "nebula",
        "base": "#080b25",
        "accent": "#8860ff",
        "motion": 0.7,
        "density": 0.8,
        "reactivity": 0.25
      },
      "overlays": [
        {
          "effect": "stardust",
          "trigger": "always",
          "color": "#c5ddff",
          "density": 0.6,
          "speed": 0.5,
          "intensity": 0.5
        }
      ],
      "options": [
        {
          "id": "count",
          "label": "Orbit particles",
          "choices": [
            {
              "value": 7,
              "label": "7 \u00b7 Minimal"
            },
            {
              "value": 14,
              "label": "14 \u00b7 Balanced"
            },
            {
              "value": 24,
              "label": "24 \u00b7 Rich"
            }
          ]
        }
      ],
      "program": {
        "version": 1,
        "state": {
          "angle": 0
        },
        "update": [
          {
            "do": "set",
            "var": "angle",
            "value": [
              "add",
              [
                "get",
                "angle"
              ],
              [
                "mul",
                [
                  "get",
                  "dt"
                ],
                [
                  "add",
                  0.28,
                  [
                    "mul",
                    [
                      "get",
                      "mid"
                    ],
                    0.25
                  ]
                ]
              ]
            ]
          }
        ],
        "draw": [
          {
            "do": "repeat",
            "count": 24,
            "index": "i",
            "body": [
              {
                "do": "if",
                "test": [
                  "lt",
                  [
                    "get",
                    "i"
                  ],
                  [
                    "get",
                    "opt_count"
                  ]
                ],
                "then": [
                  {
                    "do": "circle",
                    "x": [
                      "add",
                      0.5,
                      [
                        "mul",
                        0.24,
                        [
                          "cos",
                          [
                            "add",
                            [
                              "get",
                              "angle"
                            ],
                            [
                              "mul",
                              [
                                "get",
                                "i"
                              ],
                              0.2618
                            ]
                          ]
                        ]
                      ]
                    ],
                    "y": [
                      "add",
                      0.5,
                      [
                        "mul",
                        0.26,
                        [
                          "sin",
                          [
                            "add",
                            [
                              "get",
                              "angle"
                            ],
                            [
                              "mul",
                              [
                                "get",
                                "i"
                              ],
                              0.2618
                            ]
                          ]
                        ]
                      ]
                    ],
                    "r": [
                      "add",
                      0.007,
                      [
                        "mul",
                        [
                          "get",
                          "low"
                        ],
                        0.004
                      ]
                    ],
                    "alpha": 0.8,
                    "color": {
                      "hsl": [
                        [
                          "add",
                          0.55,
                          [
                            "mul",
                            [
                              "get",
                              "i"
                            ],
                            0.023
                          ]
                        ],
                        0.9,
                        0.64
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "do": "text",
            "x": 0.03,
            "y": 0.24,
            "text": "PULSE ATLAS",
            "size": 0.13,
            "color": "#f5ecff"
          }
        ]
      }
    },
    {
      "id": "world_lab_beat_catcher",
      "title": "Beat Catcher \u00b7 Solo / Autoplay",
      "category": "signature",
      "background": {
        "style": "arcade",
        "base": "#090b1f",
        "accent": "#e75fb9",
        "motion": 0.32,
        "density": 0.55,
        "reactivity": 0.15
      },
      "interaction": {
        "kind": "game",
        "default": "ai_ai",
        "modes": [
          "ai_ai",
          "solo"
        ],
        "action_label": "Catch bonus"
      },
      "options": [
        {
          "id": "speed",
          "label": "Target speed",
          "choices": [
            {
              "value": 0.5,
              "label": "Calm"
            },
            {
              "value": 1,
              "label": "Normal"
            },
            {
              "value": 1.7,
              "label": "Quick"
            }
          ]
        }
      ],
      "program": {
        "version": 1,
        "state": {
          "player": 0.5,
          "target": 0.4,
          "phase": 0,
          "score": 0,
          "latch": 0
        },
        "update": [
          {
            "do": "set",
            "var": "phase",
            "value": [
              "add",
              [
                "get",
                "phase"
              ],
              [
                "mul",
                [
                  "get",
                  "dt"
                ],
                [
                  "get",
                  "opt_speed"
                ]
              ]
            ]
          },
          {
            "do": "if",
            "test": [
              "get",
              "human1"
            ],
            "then": [
              {
                "do": "set",
                "var": "player",
                "value": [
                  "clamp",
                  [
                    "add",
                    [
                      "get",
                      "player"
                    ],
                    [
                      "mul",
                      [
                        "get",
                        "p1x"
                      ],
                      [
                        "mul",
                        [
                          "get",
                          "dt"
                        ],
                        0.8
                      ]
                    ]
                  ],
                  0.06,
                  0.94
                ]
              }
            ],
            "else": [
              {
                "do": "set",
                "var": "player",
                "value": [
                  "add",
                  0.5,
                  [
                    "mul",
                    0.35,
                    [
                      "sin",
                      [
                        "get",
                        "phase"
                      ]
                    ]
                  ]
                ]
              }
            ]
          },
          {
            "do": "set",
            "var": "target",
            "value": [
              "add",
              0.5,
              [
                "mul",
                0.38,
                [
                  "cos",
                  [
                    "mul",
                    [
                      "get",
                      "phase"
                    ],
                    1.4
                  ]
                ]
              ]
            ]
          },
          {
            "do": "if",
            "test": [
              "lt",
              [
                "get",
                "beat"
              ],
              0.18
            ],
            "then": [
              {
                "do": "set",
                "var": "latch",
                "value": 0
              }
            ]
          },
          {
            "do": "if",
            "test": [
              "and",
              [
                "lt",
                [
                  "abs",
                  [
                    "sub",
                    [
                      "get",
                      "player"
                    ],
                    [
                      "get",
                      "target"
                    ]
                  ]
                ],
                0.12
              ],
              [
                "and",
                [
                  "gt",
                  [
                    "get",
                    "beat"
                  ],
                  0.37
                ],
                [
                  "not",
                  [
                    "get",
                    "latch"
                  ]
                ]
              ]
            ],
            "then": [
              {
                "do": "set",
                "var": "score",
                "value": [
                  "add",
                  [
                    "get",
                    "score"
                  ],
                  1
                ]
              },
              {
                "do": "set",
                "var": "latch",
                "value": 1
              }
            ]
          },
          {
            "do": "if",
            "test": [
              "get",
              "p1a"
            ],
            "then": [
              {
                "do": "set",
                "var": "score",
                "value": [
                  "add",
                  [
                    "get",
                    "score"
                  ],
                  1
                ]
              }
            ]
          }
        ],
        "draw": [
          {
            "do": "rect",
            "x": 0,
            "y": 0.65,
            "w": 1,
            "h": 0.18,
            "color": "#11152e",
            "alpha": 0.94
          },
          {
            "do": "circle",
            "x": [
              "get",
              "target"
            ],
            "y": 0.72,
            "r": 0.042,
            "color": "#ffce55"
          },
          {
            "do": "rect",
            "x": [
              "sub",
              [
                "get",
                "player"
              ],
              0.035
            ],
            "y": 0.78,
            "w": 0.07,
            "h": 0.07,
            "color": "#64eaff"
          },
          {
            "do": "text",
            "x": 0.04,
            "y": 0.23,
            "size": 0.2,
            "text": "BEAT CATCHER",
            "color": "#f5efff"
          },
          {
            "do": "text",
            "x": 0.74,
            "y": 0.23,
            "size": 0.17,
            "text": "SCORE ",
            "value": [
              "get",
              "score"
            ],
            "color": "#fff2a5"
          }
        ]
      }
    },
    {
